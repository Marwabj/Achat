pipeline {
    agent any

    tools {
        maven 'Maven'
    }

    environment {
        JAVA_HOME = '/opt/java/openjdk'
        PATH = "${JAVA_HOME}/bin:${env.PATH}"
        IMAGE_NAME = 'achat'
        IMAGE_TAG = '1.0'
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: 'developer',
                    url: 'https://github.com/Marwabj/Achat.git'
            }
        }

        stage('Build') {
            steps {
                dir('achat') {
                    sh 'mvn clean package -DskipTests'
                }
            }
        }

        stage('Test') {
            steps {
                dir('achat') {
                    sh 'mvn test'
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                dir('achat') {
                    withSonarQubeEnv('SonarQube') {
                        sh 'mvn sonar:sonar -Dsonar.projectKey=achat'
                    }
                }
            }
        }

        stage('Deploy to Nexus') {
            steps {
                dir('achat') {
                    withCredentials([usernamePassword(
                        credentialsId: 'nexus-credentials',
                        usernameVariable: 'NEXUS_USER',
                        passwordVariable: 'NEXUS_PASS'
                    )]) {
                        sh '''
                            cat > /tmp/settings.xml << EOF
<settings>
  <servers>
    <server>
      <id>nexus-releases</id>
      <username>$NEXUS_USER</username>
      <password>$NEXUS_PASS</password>
    </server>
  </servers>
</settings>
EOF
                            mvn deploy -DskipTests \
                            -s /tmp/settings.xml \
                            -DaltDeploymentRepository=nexus-releases::default::http://host.docker.internal:8081/repository/maven-releases/
                        '''
                    }
                }
            }
        }

        stage('Docker Build') {
            steps {
                dir('achat') {
                    sh 'ls -la target/'
                    sh 'docker build -t ${IMAGE_NAME}:${IMAGE_TAG} .'
                }
            }
        }

        stage('Docker Run') {
            steps {
                dir('achat') {
                    sh '''
                        docker stop achat-app || true
                        docker rm achat-app || true
                        docker-compose up -d
                    '''
                }
            }
        }

        stage('Archive') {
            steps {
                dir('achat') {
                    archiveArtifacts artifacts: 'target/*.jar', fingerprint: true
                }
            }
        }
    }

    post {
        success { echo 'Pipeline complet — application déployée dans Docker !' }
        failure { echo 'Build en échec.' }
    }
}