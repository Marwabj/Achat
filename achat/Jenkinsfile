pipeline {
    agent any

    tools {
        maven 'Maven'
    }

    environment {
        JAVA_HOME = '/opt/java/openjdk'
        PATH = "${JAVA_HOME}/bin:${env.PATH}"
        IMAGE_NAME = 'achat'
        IMAGE_TAG = '1.0'
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: 'developer',
                    url: 'https://github.com/Marwabj/Achat.git'
            }
        }

        stage('Build') {
            steps {
                dir('achat') {
                    sh 'mvn clean package -DskipTests'
                }
            }
        }

        stage('OWASP Dependency Check') {
            steps {
                dir('achat') {
                    sh 'mvn org.owasp:dependency-check-maven:8.4.0:check -DfailBuildOnCVSS=7 || true'
                }
            }
            post {
                always {
                    archiveArtifacts artifacts: 'achat/target/dependency-check-report.html',
                                     allowEmptyArchive: true
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                dir('achat') {
                    withSonarQubeEnv('SonarQube') {
                        sh 'mvn sonar:sonar -Dsonar.projectKey=achat'
                    }
                }
            }
        }

        stage('Deploy to Nexus') {
            steps {
                dir('achat') {
                    withCredentials([usernamePassword(
                        credentialsId: 'nexus-credentials',
                        usernameVariable: 'NEXUS_USER',
                        passwordVariable: 'NEXUS_PASS'
                    )]) {
                        sh '''
                            cat > /tmp/settings.xml << EOF
<settings>
  <servers>
    <server>
      <id>nexus-releases</id>
      <username>$NEXUS_USER</username>
      <password>$NEXUS_PASS</password>
    </server>
  </servers>
</settings>
EOF
                            mvn deploy -DskipTests \
                            -s /tmp/settings.xml \
                            -DaltDeploymentRepository=nexus-releases::default::http://host.docker.internal:8081/repository/maven-releases/
                        '''
                    }
                }
            }
        }

        stage('Docker Build') {
            steps {
                dir('achat') {
                    sh 'docker build -t ${IMAGE_NAME}:${IMAGE_TAG} .'
                }
            }
        }

        stage('Trivy Scan') {
            steps {
                sh '''
                    docker run --rm \
                        -v /var/run/docker.sock:/var/run/docker.sock \
                        -v trivy-cache:/root/.cache/trivy \
                        aquasec/trivy:latest image \
                        --severity HIGH,CRITICAL \
                        --scanners vuln \
                        --timeout 20m \
                        --no-progress \
                        --exit-code 0 \
                        achat:1.0
                '''
            }
        }

        stage('Docker Run') {
            steps {
                sh '''
                    docker stop achat-app || true
                    docker rm achat-app || true
                    docker run -d \
                        --name achat-app \
                        -p 8090:8089 \
                        -e SPRING_DATASOURCE_URL=jdbc:mysql://host.docker.internal:3306/achat?createDatabaseIfNotExist=true \
                        -e SPRING_DATASOURCE_USERNAME=user \
                        -e SPRING_DATASOURCE_PASSWORD=password \
                        achat:1.0
                '''
            }
        }

        stage('OWASP ZAP Scan') {
            steps {
                sh '''
                    docker run --rm \
                        --network host \
                        -v /tmp/zap-reports:/zap/wrk:rw \
                        ghcr.io/zaproxy/zaproxy:stable \
                        zap-baseline.py \
                        -t http://localhost:8090/SpringMVC \
                        -r zap-report.html \
                        -I || true
                    cp /tmp/zap-reports/zap-report.html . || true
                '''
            }
            post {
                always {
                    archiveArtifacts artifacts: 'zap-report.html',
                                     allowEmptyArchive: true
                }
            }
        }

        stage('Archive') {
            steps {
                dir('achat') {
                    archiveArtifacts artifacts: 'target/*.jar', fingerprint: true
                }
            }
        }
    }

    post {
        success { echo 'Pipeline complet — application déployée dans Docker !' }
        failure { echo 'Build en échec.' }
    }
}