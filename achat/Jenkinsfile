pipeline {
    agent any

    tools {
        maven 'Maven'
    }

    environment {
        JAVA_HOME = '/opt/java/openjdk'
        PATH = "${JAVA_HOME}/bin:${env.PATH}"
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: 'developer',
                    url: 'https://github.com/Marwabj/Achat.git'
            }
        }

        stage('Build') {
            steps {
                dir('achat') {
                    sh 'mvn clean package -DskipTests'
                }
            }
        }

        stage('Test') {
            steps {
                dir('achat') {
                    sh 'mvn test'
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                dir('achat') {
                    withSonarQubeEnv('SonarQube') {
                        sh 'mvn sonar:sonar -Dsonar.projectKey=achat'
                    }
                }
            }
        }

        stage('Deploy to Nexus') {
            steps {
                dir('achat') {
                    withCredentials([usernamePassword(
                        credentialsId: 'nexus-credentials',
                        usernameVariable: 'NEXUS_USER',
                        passwordVariable: 'NEXUS_PASS'
                    )]) {
                        sh '''
                            cat > /tmp/settings.xml << EOF
<settings>
  <servers>
    <server>
      <id>nexus-snapshots</id>
      <username>$NEXUS_USER</username>
      <password>$NEXUS_PASS</password>
    </server>
  </servers>
</settings>
EOF
                            mvn deploy -DskipTests \
                            -s /tmp/settings.xml \
                            -DaltDeploymentRepository=nexus-snapshots::default::http://host.docker.internal:8081/repository/maven-snapshots/
                        '''
                    }
                }
            }
        }

        stage('Archive') {
            steps {
                dir('achat') {
                    archiveArtifacts artifacts: 'target/*.jar', fingerprint: true
                }
            }
        }
    }

    post {
        success { echo 'Build réussi !' }
        failure { echo 'Build en échec.' }
    }
}